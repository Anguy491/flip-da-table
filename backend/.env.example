APP_JWT_SECRET=<at-least-32-bytes-random-secret>
APP_PUBLIC_URL=http://localhost:5173

APP_AUTH_PASSWORD_RESET_ENABLED=true
APP_AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com

